# .env.example
# Production Environment Configuration Template for AI Job Copilot Platform

# 1. Application Settings
APP_ENV=production
APP_SECRET_KEY=generate-a-secure-32-byte-hex-string-for-jwt-signing
ALLOWED_ORIGINS=https://jobcopilot.example.com

# 2. Database (PostgreSQL) Configurations
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate-a-secure-database-password
POSTGRES_DB=jobcopilot_db
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=5

# 3. Redis Caching Settings
REDIS_URL=redis://redis_cache:6379/0

# 4. LLM Service Configurations
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-if-switching-to-openai

# 5. Security & JWT Expirations
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 6. File Storage Limits
MAX_UPLOAD_SIZE_MB=5
STORAGE_VOLUME_PATH=/app/storage
