# backend/.env.example
# Backend environment variables configuration template

# Environment stage
ENV=development

# Security JWT configurations
SECRET_KEY=supersecretkeyrunninginlocalenvdevplaceholder123
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS origins (can be JSON array, comma-separated string, or single string)
ALLOWED_ORIGINS=["http://localhost:3000"]

# Database settings
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobcopilot_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Cache connection
REDIS_URL=redis://localhost:6379/0

# Logger settings
LOG_LEVEL=INFO
